# Copy to .env (git-ignored) and adjust. Loaded via spring.config.import=optional:file:.env[.properties]
# Keys must be canonical Spring property names (not SPRING_DATASOURCE_URL style).
spring.datasource.url=jdbc:postgresql://localhost:5432/zovra
spring.datasource.username=zovra
spring.datasource.password=change-me
security.jwt.secret=change-me-to-a-long-random-string
security.jwt.expiration-minutes=60
app.cors.allowed-origins=http://localhost:5173
app.insights.ai-enabled=false
spring.ai.openai.api-key=
